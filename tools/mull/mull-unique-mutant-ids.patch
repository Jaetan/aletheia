 void MutationPoint::updateIdentifier() {
+  // The ordinal counts this function's mutants of the same mutator at the
+  // same start, in instruction order, which is the same order in every
+  // translation unit that compiles the function.
+  static std::mutex ordinalsMutex;
+  static std::unordered_map<std::string, int> ordinals;
+  std::string functionName = originalFunction ? originalFunction->getName().str() : "";
+  if (ordinal < 0) {
+    std::string key = functionName + '#' + mutator->getUniqueIdentifier() + ':' +
+                      sourceLocation.filePath + ':' + std::to_string(sourceLocation.line) + ':' +
+                      std::to_string(sourceLocation.column);
+    std::lock_guard<std::mutex> lock(ordinalsMutex);
+    ordinal = ordinals[key]++;
+  }
+  unsigned long long hash = 1469598103934665603ULL;
+  for (unsigned char c : functionName) {
+    hash ^= c;
+    hash *= 1099511628211ULL;
+  }
+  std::ostringstream discriminator;
+  discriminator << std::hex << (hash & 0xffffffffULL) << '.' << std::dec << ordinal;
   userIdentifier = mutator->getUniqueIdentifier() + ':' + sourceLocation.filePath + ':' +
