+/// Whether an indirect call is a virtual dispatch: under the Itanium ABI at
+/// -O0 the callee is loaded from a vtable slot, which is a pointer loaded from
+/// the object, either directly for the first slot or through an index into
+/// the table.  A call through a function pointer loads the callee from a
+/// member of a struct or from a stack slot instead.
+static bool isVirtualDispatch(llvm::CallBase *call) {
+  auto *callee = llvm::dyn_cast<llvm::LoadInst>(call->getCalledOperand());
+  if (!callee) {
+    return false;
+  }
+  llvm::Value *slot = callee->getPointerOperand();
+  if (auto *index = llvm::dyn_cast<llvm::GetElementPtrInst>(slot)) {
+    if (!index->getSourceElementType()->isPointerTy()) {
+      return false;
+    }
+    slot = index->getPointerOperand();
+  }
+  return llvm::isa<llvm::LoadInst>(slot);
+}
+
+/// Whether the value reaches a comparison with null in its function.  At -O0
+/// a call's result is stored to a stack slot and loaded again before it is
+/// compared, so the stores to a slot are followed through that slot's loads;
+/// a phi or a select forwards the value too.  The depth bound ends a cycle.
+static bool reachesNullComparison(llvm::Value *value, unsigned depth) {
+  if (depth == 0) {
+    return false;
+  }
+  for (llvm::User *user : value->users()) {
+    if (auto *compare = llvm::dyn_cast<llvm::ICmpInst>(user)) {
+      if (llvm::isa<llvm::ConstantPointerNull>(compare->getOperand(0)) ||
+          llvm::isa<llvm::ConstantPointerNull>(compare->getOperand(1))) {
+        return true;
+      }
+      continue;
+    }
+    if (auto *store = llvm::dyn_cast<llvm::StoreInst>(user)) {
+      if (store->getValueOperand() != value) {
+        continue;
+      }
+      if (auto *slot = llvm::dyn_cast<llvm::AllocaInst>(store->getPointerOperand())) {
+        for (llvm::User *slotUser : slot->users()) {
+          if (llvm::isa<llvm::LoadInst>(slotUser) && reachesNullComparison(slotUser, depth - 1)) {
+            return true;
+          }
+        }
+      }
+      continue;
+    }
+    if (llvm::isa<llvm::PHINode>(user) || llvm::isa<llvm::SelectInst>(user)) {
+      if (reachesNullComparison(user, depth - 1)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
 
