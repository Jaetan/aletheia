+/// A call returning one bit, which is a bool: the integer replacement's
+/// constant truncates to false on it, so the other answer needs a replacement
+/// of its own.
+class BoolCallReplacement : public CallReplacement {
+public:
+  explicit BoolCallReplacement(bool value)
+      : CallReplacement(new IntValueConstructor(value ? 1 : 0), llvm::Type::IntegerTyID, 1, 1) {}
+};
+
+/// A call returning a pointer, replaced by the null pointer of its type where
+/// null is an answer the caller reads.  A call whose result is never compared
+/// with null, a string's data or an exception's message, does not answer null,
+/// and replacing it would measure the language's undefined behaviour rather
+/// than the program.
+class PointerCallReplacement : public CallReplacement {
+public:
+  PointerCallReplacement()
+      : CallReplacement(new NullPointerConstructor(), llvm::Type::PointerTyID, 0, 0, true) {}
+};
+
