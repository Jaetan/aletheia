     visitor.TraverseDecl(decl);
     return visitor.foundMutant();
   }
diff --git a/lib/JunkDetection/CXX/Visitors/ReplaceCallVisitor.cpp b/lib/JunkDetection/CXX/Visitors/ReplaceCallVisitor.cpp
index ad76010..ea05263 100644
--- a/lib/JunkDetection/CXX/Visitors/ReplaceCallVisitor.cpp
