+  enum class Returns { Real, Bool, Pointer };
+
+  ReplaceCallVisitor(const VisitorParameters &parameters, Returns returns);
 
   bool VisitCallExpr(clang::CallExpr *callExpression);
   bool VisitCXXMemberCallExpr(clang::CXXMemberCallExpr *callExpression);
@@ -19,6 +23,7 @@ public:
 
