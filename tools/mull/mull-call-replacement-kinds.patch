+  case MutatorKind::CXX_ReplaceBoolCallTrue: {
+    ReplaceCallVisitor visitor(visitorParameters, ReplaceCallVisitor::Returns::Bool);
+    visitor.TraverseDecl(decl);
+    return visitor.foundMutant();
+  }
+  case MutatorKind::CXX_ReplacePointerCallNull: {
