diff --git a/include/mull/Mutators/CXX/CallMutators.h b/include/mull/Mutators/CXX/CallMutators.h
index b1b5fc6..712fa1f 100644
--- a/include/mull/Mutators/CXX/CallMutators.h
+++ b/include/mull/Mutators/CXX/CallMutators.h
@@ -26,5 +26,21 @@ public:
   ReplaceScalarCall();
 };
 
+/// The scalar replacement's constant truncates to false on a call returning
+/// bool, so that mutant stands for a predicate answering no and never one
+/// answering yes.  This one is the other answer.
+class ReplaceBoolCallTrue : public TrivialCXXMutator {
+public:
+  static std::string ID();
+  ReplaceBoolCallTrue();
+};
+
+/// A call returning a pointer, answered by the null pointer instead.
+class ReplacePointerCallNull : public TrivialCXXMutator {
+public:
+  static std::string ID();
+  ReplacePointerCallNull();
+};
+
 } // namespace cxx
 } // namespace mull
