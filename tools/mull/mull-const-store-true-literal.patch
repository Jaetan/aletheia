+/// Whether the expression is the literal true.  The constant-store
+/// replacements write 42 where the source wrote true, and a bool occupies a
+/// byte, in which 42 is still true: the mutant cannot be told from the
+/// program, so a store of true is not a mutation site.
+static bool isTrueLiteral(const clang::Expr *expression) {
+  if (!expression) {
+    return false;
+  }
+  auto *literal = llvm::dyn_cast<clang::CXXBoolLiteralExpr>(expression->IgnoreImplicit());
+  return literal && literal->getValue();
+}
