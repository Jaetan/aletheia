cabal-version:      3.12
-- SPDX-FileCopyrightText: 2025 Nicolas Pelletier
-- SPDX-License-Identifier: BSD-2-Clause
name:               aletheia-build
version:            5.0.0.0
build-type:         Simple

executable shake
    main-is:          Shakefile.hs
    hs-source-dirs:   ., shake
    other-modules:
        Shared
        Rules.Dist
        Rules.Ffi
        Rules.Gates
        Rules.Install
        Rules.Library
        Rules.Proofs
    build-depends:
        base >= 4.18.3.0 && < 5,
        shake >= 0.19,
        directory,
        filepath
    default-language: Haskell2010
    ghc-options:
        -threaded -rtsopts -with-rtsopts=-I0
        -- A module the build imports that other-modules does not list fails it.
        -Werror=missing-home-modules
