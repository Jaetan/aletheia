---
# Every key here changes a value the base style sets differently. A value the
# base style already gives is not restated, so this file reads as the list of
# decisions the project has taken rather than as a copy of the style it starts
# from. A probe pins the effective configuration, so a base-style change that
# moves one of the values this file leaves alone is caught rather than absorbed.
Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -4

# Line width
ColumnLimit: 100

# Pointer/reference alignment: Type* name
PointerAlignment: Left
ReferenceAlignment: Left

# Alignment
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None

# Short forms
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: InlineOnly

# Breaking
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: CurrentLine
BreakTemplateDeclarations: Yes

# Spaces
SpaceAfterTemplateKeyword: false
SpacesInContainerLiterals: false

# Using-declarations, sorted within their block
SortUsingDeclarations: Lexicographic

# Miscellaneous
InsertNewlineAtEOF: true
RemoveSemicolon: true
