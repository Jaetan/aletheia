---
# Enable all checks, then selectively disable.
# Disables that only test code earns live in cpp/tests/.clang-tidy, which
# inherits this file; every check disabled below fires on the library.
# Disabled categories:
#   altera-*          — FPGA-specific (Intel/Altera OpenCL)
#   fuchsia-*         — Fuchsia OS conventions (default constructors, overloaded operators)
#   llvmlibc-*        — LLVM libc internal conventions
#   android-*         — Android NDK conventions
#   abseil-*          — Abseil library conventions (we don't use Abseil)
#   zircon-*          — Fuchsia Zircon kernel conventions
#   linuxkernel-*     — Linux kernel C conventions
#
# Individual disables:
#   modernize-use-trailing-return-type  — we use trailing returns where chosen;
#       enabling forces it everywhere including main() and simple getters
#   readability-identifier-length       — single-letter vars are fine in lambdas/loops
#   cppcoreguidelines-avoid-magic-numbers, readability-magic-numbers
#       — signal processing code legitimately uses numeric constants (0xFF, 8, 256)
#   misc-non-private-member-variables-in-classes
#       — our strong types and aggregate structs intentionally expose members
#   cppcoreguidelines-pro-bounds-constant-array-index
#       — std::array<std::byte,8> with constant indices is safe
#   readability-uppercase-literal-suffix
#       — 0xFF vs 0XFF: lowercase hex is more readable
#   misc-no-recursion
#       — LTL formula serialization is naturally recursive
#   cppcoreguidelines-owning-memory
#       — void* for opaque FFI state is intentional
#   llvm-header-guard
#       — we use #pragma once
#   bugprone-easily-swappable-parameters
#       — strong typedefs already prevent parameter swaps at the type level
#   performance-unnecessary-value-param
#       — strong types are tiny; pass-by-value is intentional for 8-16 byte wrappers
#   google-readability-braces-around-statements,
#   hicpp-braces-around-statements,
#   readability-braces-around-statements
#       — we prefer compact single-statement bodies: if (x) return y;
#   performance-enum-size
#       — suggesting uint8_t base for small enums; premature optimization, harms debuggability
#   concurrency-mt-unsafe
#         flags std::getenv and dlerror, which the library calls once while
#         loading the shared library or reading its environment (ffi_backend.cpp,
#         rational_renderer.cpp, cli.cpp) and test helpers call for setup
#   misc-use-anonymous-namespace
#       — INVERSE of llvm-prefer-static-over-anonymous-namespace (our adopted style:
#         `static` for file-local functions/vars, anon namespace only for types);
#         enabling both deadlocks
#   portability-avoid-pragma-once
#       — we use #pragma once (cf. llvm-header-guard); its portability concern
#         (embedded / network-FS compilers) is inert for our Clang-only build
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#       — operator[] on pre-validated indices is intentional; .at() would add
#         hot-path bounds-check exceptions (we self-check our bounds)

Checks: >
  *,
  -altera-*,
  -fuchsia-*,
  -llvmlibc-*,
  -android-*,
  -abseil-*,
  -zircon-*,
  -linuxkernel-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -readability-uppercase-literal-suffix,
  -misc-no-recursion,
  -cppcoreguidelines-owning-memory,
  -llvm-header-guard,
  -bugprone-easily-swappable-parameters,
  -performance-unnecessary-value-param,
  -google-readability-braces-around-statements,
  -hicpp-braces-around-statements,
  -readability-braces-around-statements,
  -performance-enum-size,
  -concurrency-mt-unsafe,
  -misc-use-anonymous-namespace,
  -portability-avoid-pragma-once,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access

# Make findings fatal. Combined with CMAKE_CXX_CLANG_TIDY in CMakeLists.txt
# (opt-in via -DALETHEIA_CLANG_TIDY=ON), this turns drift into a compile-time
# error instead of an after-the-fact audit.
WarningsAsErrors: '*'

HeaderFilterRegex: 'include/aletheia/.*\.hpp$|src/detail/.*\.hpp$'

CheckOptions:
  # Naming conventions — match existing code style
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  # Private class members get trailing underscore
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'
  # Public struct members: no suffix (aggregates use bare names)
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PublicMemberSuffix: ''
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.StaticConstantCase: lower_case
  readability-identifier-naming.GlobalConstantCase: lower_case
  # Thresholds
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-size.LineThreshold: 80
  readability-function-size.ParameterThreshold: 8
  # An argument comment that is present must match the parameter name exactly
  # (no case or underscore leniency); comments are not required.
  bugprone-argument-comment.StrictMode: 'true'
  # Headers a call site must not be asked to name. The vendored umbrellas
  # legitimately re-export symbols their own detail subtrees declare; bits/ is
  # where the standard library keeps what its public headers include; and the
  # POSIX surface (popen, setenv, the wait macros) is declared in the C headers
  # that <cstdio> and <cstdlib> include, so naming a provider for it would mean
  # naming a C header that modernize-deprecated-headers then rejects.
  misc-include-cleaner.IgnoreHeaders: 'nlohmann/.*;OpenXLSX.*;yaml-cpp/.*;bits/.*;stdio.h;stdlib.h;sys/.*'
